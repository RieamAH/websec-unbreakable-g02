model
  schema 1.1

# Opdracht 4 - autorisatiemodel van Unbreakable (ReBAC).
# Dit bestand is de ENIGE plaats waar staat wie wat mag met een bericht.
# De API (PEP) vraagt enkel "mag user:X can_read/can_delete op message:Y?".

type user

type message
  relations
    # Feiten (tuples), weggeschreven door de API bij elk nieuw bericht.
    define sender: [user]
    define recipient: [user]

    # Regels (permissies), afgeleid uit de feiten.
    define can_read: recipient
    define can_delete: sender
